<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>{{ .Title }} — DB Log</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/static/css/base.css">
    </head>
    <body>
        <nav>
            <a class="brand" href="/">
                <img src="/static/img/docker_small.png" alt="Docker">
                {{ .Title }}
            </a>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/db" class="active">DB Log</a></li>
            </ul>
        </nav>
        <div class="page">
            <div class="db-header">
                <h2>Request Log</h2>
                <span class="count">{{ len .Entries }} entries</span>
            </div>
            {{ if .Entries }}
            <table class="log-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Remote Address</th>
                        <th>Path</th>
                    </tr>
                </thead>
                <tbody>
                    {{ range .Entries }}
                    <tr>
                        <td class="col-num">{{ .Num }}</td>
                        <td class="col-date">{{ .Date.Format "2006-01-02 15:04:05" }}</td>
                        <td class="col-addr">{{ .Addr }}</td>
                        <td class="col-path">{{ .Path }}</td>
                    </tr>
                    {{ end }}
                </tbody>
            </table>
            {{ else }}
            <div class="empty-state">No log entries yet — make some requests!</div>
            {{ end }}
            <footer>served from {{ .Hostname }}</footer>
        </div>
    </body>
</html>
